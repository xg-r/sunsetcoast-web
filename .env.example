# 백엔드 API 주소 (끝에 / 없이). 프론트는 빌드 때 이 값을 HTML/JS에 넣는다.
#   로컬:  http://localhost:8080  (npm run mock 으로 목 서버 실행)
#   운영:  백엔드 배포 후 정함. 비워 두면 노을 시각 영역을 숨긴다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# GA4 측정 ID는 환경별 파일에서 관리한다 (저장소에 포함).
#   .env.production   운영 ID + NEXT_PUBLIC_GA_HOST (그 도메인에서만 보냄)
#   .env.development  비워 두면 보내지 않고 콘솔에만 [track] 로그
# 로컬에서 따로 시험용 GA4를 쓰려면 여기(.env.local)에 NEXT_PUBLIC_GA_ID=G-시험용ID 를 넣는다.

