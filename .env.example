# 백엔드 API 주소 (끝에 / 없이). 프론트는 빌드 때 이 값을 HTML/JS에 넣는다.
#   로컬:  http://localhost:8080  (npm run mock 으로 목 서버 실행)
#   운영:  백엔드 배포 후 정함. 비워 두면 노을 시각 영역을 숨긴다.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 사이트 데이터(객실·사진·요금 등) API. 빌드 때 서버에서만 쓰고 브라우저에는 넣지 않는다 (NEXT_PUBLIC_ 아님).
#   비워 두면 seed 데이터(src/lib/seed)로 빌드한다.
#   로컬 목 서버:  SITE_DATA_API_URL=http://localhost:8080  SITE_DATA_TOKEN=dev-token
#   계약: docs/api/site-data.md
SITE_DATA_API_URL=
SITE_DATA_TOKEN=
